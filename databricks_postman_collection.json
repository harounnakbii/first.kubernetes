        {
          "name": "CREATE Job (Notebook)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.job_id) {",
                  "    pm.collectionVariables.set('JOB_ID', String(jsonData.job_id));",
                  "    console.log('✅ Job ID sauvegardé:', jsonData.job_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{DATABRICKS_PAT}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mon Job Notebook - Postman\",\n  \"tasks\": [\n    {\n      \"task_key\": \"notebook_task_1\",\n      \"description\": \"Exécution du notebook principal\",\n      \"notebook_task\": {\n        \"notebook_path\": \"{{NOTEBOOK_PATH}}\",\n        \"base_parameters\": {\n          \"env\": \"production\",\n          \"date\": \"{{$isoTimestamp}}\"\n        }\n      },\n      \"job_cluster_key\": \"job_cluster\",\n      \"timeout_seconds\": 3600\n    }\n  ],\n  \"job_clusters\": [\n    {\n      \"job_cluster_key\": \"job_cluster\",\n      \"new_cluster\": {\n        \"spark_version\": \"13.3.x-scala2.12\",\n        \"node_type_id\": \"Standard_DS3_v2\",\n        \"num_workers\": 2\n      }\n    }\n  ],\n  \"schedule\": {\n    \"quartz_cron_expression\": \"0 0 8 * * ?\",\n    \"timezone_id\": \"Europe/Paris\",\n    \"pause_status\": \"PAUSED\"\n  },\n  \"max_retries\": 1,\n  \"timeout_seconds\": 7200\n}"
            },
            "url": {
              "raw": "{{DATABRICKS_HOST}}/api/2.1/jobs/create",
              "host": ["{{DATABRICKS_HOST}}"],
              "path": ["api", "2.1", "jobs", "create"]
            },
            "description": "Crée un job exécutant un notebook avec un cluster éphémère.\n\nLe planning CRON est mis en pause par défaut (`PAUSED`). Changer en `UNPAUSED` pour activer."
          }
        },
        {
          "name": "RUN Job Now",
          "event": [
