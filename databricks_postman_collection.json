        {
          "name": "CREATE Cluster",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.cluster_id) {",
                  "    pm.collectionVariables.set('CLUSTER_ID', jsonData.cluster_id);",
                  "    console.log('✅ Cluster ID sauvegardé:', jsonData.cluster_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{DATABRICKS_PAT}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cluster_name\": \"my-cluster-postman\",\n  \"spark_version\": \"13.3.x-scala2.12\",\n  \"node_type_id\": \"Standard_DS3_v2\",\n  \"autotermination_minutes\": 30,\n  \"num_workers\": 2,\n  \"spark_conf\": {\n    \"spark.databricks.delta.preview.enabled\": \"true\"\n  }\n}"
            },
            "url": {
              "raw": "{{DATABRICKS_HOST}}/api/2.0/clusters/create",
              "host": ["{{DATABRICKS_HOST}}"],
              "path": ["api", "2.0", "clusters", "create"]
            },
            "description": "Crée un nouveau cluster interactif.\n\nModifier `node_type_id` selon votre cloud :\n- **Azure**: `Standard_DS3_v2`\n- **AWS**: `i3.xlarge`\n- **GCP**: `n1-standard-4`"
          }
        },
